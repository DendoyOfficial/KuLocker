* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background-color: #f4f5f7;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.background-container {
  width: 80vw;
  height: 80vh;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10px;

  position: relative;
  overflow: hidden;
}

.background-container::before {
  content: "";
  position: absolute;
  top: -10px;
  right: -10px;
  bottom: -10px;
  left: -10px;

  background-image: url("../image/Locker.jpg");
  background-size: cover;
  background-position: center;
  filter: blur(5px);
 /* ini buat bluring nya ya */
  z-index: -1;
}

.login-card {
  background-color: #ffffff;
  display: flex;
  width: 600px;
  height: 400px;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
}

/* KOLOM KIRI */
.card-left {
  flex: 1;
  background-image: url("../image/Locker.jpg");
  background-size: cover;
  position: relative;
}

.overlay-text {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: rgb(255, 255, 255);
  font-size: 12px;
}

/* KOLOM KANAN */
.card-right {
  background-color: #ffffff;
  flex: 1;
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.form-title {
  font-size: 22px;
  margin-bottom: 30px;
}

.text-yellow {
  color: #fbc531; /* Sedikit disamakan dengan warna tombol kuningnya */
}

/* Jarak antar input */
.input-group {
  margin-bottom: 20px;
}

/* Teks label kecil di atas input */
.input-group label {
  display: block;
  font-size: 10px;
  font-weight: bold;
  margin-bottom: 5px;
}

/* Kolom inputnya */
.input-group input {
  width: 100%;
  padding: 12px 15px;
  background-color: #e3e0e0;
  border: none;
  border-radius: 25px;
  outline: none;
}

/* Tombol Sign In */
.btn-submit {
  width: 100%;
  padding: 12px;
  background-color: #fbc531;
  color: white;
  border: none;
  border-radius: 25px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
}

.btn-submit:hover {
  background-color: #e1b12c;
}

/* Teks Sign Up di bawah tombol */
.register-text {
  text-align: center;
  font-size: 10px;
  margin-top: 15px;
  color: #666;
}

.register-text a {
  color: #007bff;
  text-decoration: none;
}
